# NebulaSEO configuration.
# Copy to .env and edit. Never commit .env; it is excluded by .gitignore.
# docker compose reads this file for both services.

# --- Gemini model access ------------------------------------------------------
# The agent talks to Gemini either through the Gemini API or through Vertex AI.
#
# Option A, Gemini API: set GOOGLE_GENAI_USE_VERTEXAI=False and supply a key from
#   https://aistudio.google.com/apikey
# Option B, Vertex AI: set GOOGLE_GENAI_USE_VERTEXAI=True, set GOOGLE_CLOUD_PROJECT,
#   and authenticate with `gcloud auth application-default login`. GEMINI_API_KEY is
#   not used in this mode.
GOOGLE_GENAI_USE_VERTEXAI=False
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# --- Target site --------------------------------------------------------------
# The site the agent audits and optimises.
TARGET_SITE_URL=https://example.com
# Search Console property, in the form Search Console reports it.
# Domain properties use the sc-domain: prefix; URL-prefix properties use the full URL.
GSC_SITE_URL=sc-domain:example.com

# --- GitHub (autonomous pull requests) ----------------------------------------
# Fine-grained token with Contents and Pull requests write access on the target repo.
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo

# --- Agent API authentication -------------------------------------------------
# Shared secret required by the /chat and /automate endpoints, sent as a Bearer
# token or an X-Agent-Token header. If left empty, those endpoints are unauthenticated,
# which is only appropriate for local development.
AGENT_TOKEN=

# --- Google APIs (optional) ---------------------------------------------------
# Analytics reporting. Numeric GA4 property id, without the "properties/" prefix.
GA4_PROPERTY_ID=
# PageSpeed Insights. Raises the anonymous rate limit; the API also works without a key.
GOOGLE_PSI_API_KEY=
# Programmable Search, used by the SERP analysis tools.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# --- Dashboard authentication (Clerk) -----------------------------------------
# Keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# --- Service wiring -----------------------------------------------------------
# Agent URL as reached from the browser.
NEXT_PUBLIC_AGENT_URL=http://localhost:8080
# Agent URL as reached from the dashboard container.
AGENT_INTERNAL_URL=http://agent:8080
# Port the agent listens on.
PORT=8080
